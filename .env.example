# ── Quote form ───────────────────────────────────────────────────────
# Storage runs BEFORE email, so a lead survives a provider outage.
# Set ONE of the Postgres URLs, or QUOTE_LOG_FILE for local work.
# With neither set the form fails loudly rather than dropping submissions.

QUOTE_DATABASE_URL=postgres://user:password@host:5432/dbname
# POSTGRES_URL=          # Vercel Postgres sets this for you
# DATABASE_URL=          # Supabase / Neon convention

# Local development: append-only JSONL instead of a database.
# QUOTE_LOG_FILE=.data/quotes.jsonl

# ── Email ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
QUOTE_FROM_EMAIL="Surge Labs <quotes@surgelabs.ca>"
QUOTE_TO_EMAIL=hello@surgelabs.ca

# The sending domain must be verified in Resend before anything sends.

# ── Analytics ────────────────────────────────────────────────────────
# Meta Pixel. Public by nature — it is visible in the page source — so this
# is not a secret, it is a switch. Leave it unset to use the id compiled into
# lib/analytics/config.ts, point it at a different pixel for staging, or set
# it empty to turn tracking off entirely without touching code.
# Tracking never runs outside a production build regardless of this value.
# NEXT_PUBLIC_META_PIXEL_ID=4738023989799471

# ── Build scripts ────────────────────────────────────────────────────
# scripts/fetch-media.mjs downloads the generated stills and loops from
# Higgsfield's CDN. Set this to point it at a mirror instead — a local
# directory served over http, or a re-host — when the CDN is unreachable.
# Only the filename carries identity, so a mirror needs the basenames and
# nothing else.
# MEDIA_BASE=http://127.0.0.1:8899
