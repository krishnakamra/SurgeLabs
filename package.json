{
  "name": "surgelabs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:local": "node --experimental-strip-types --import ./scripts/register.mjs scripts/check-local-pages.mjs",
    "gen:local-images": "node --experimental-strip-types --import ./scripts/register.mjs scripts/generate-local-images.mjs",
    "gen:brand": "node --experimental-strip-types --import ./scripts/register.mjs scripts/generate-brand-assets.mjs",
    "prebuild": "npm run check:local && npm run check:portfolio && npm run check:seo && npm run check:routes && npm run check:env",
    "check:seo": "node --conditions=react-server --experimental-strip-types --import ./scripts/register.mjs scripts/check-seo.mjs",
    "check:routes": "node --conditions=react-server --experimental-strip-types --import ./scripts/register.mjs scripts/check-routes.mjs",
    "check:redirects": "node --conditions=react-server --experimental-strip-types --import ./scripts/register.mjs scripts/check-redirects.mjs",
    "check:env": "node scripts/check-env-docs.mjs",
    "verify:live": "node --conditions=react-server --experimental-strip-types --import ./scripts/register.mjs scripts/verify-live.mjs",
    "shots": "node --experimental-strip-types --import ./scripts/register.mjs scripts/capture-portfolio.mjs",
    "check:portfolio": "node --experimental-strip-types --import ./scripts/register.mjs scripts/check-portfolio.mjs",
    "ad": "node --experimental-strip-types --import ./scripts/register.mjs scripts/make-ad.mjs",
    "ad:photo": "node --experimental-strip-types --import ./scripts/register.mjs scripts/make-photo-ad.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "15.5.23",
    "next-mdx-remote": "^6.0.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.22.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
